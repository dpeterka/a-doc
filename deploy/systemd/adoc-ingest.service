[Unit]
Description=a-doc document ingestion pipeline (one-shot)

[Service]
Type=oneshot
User=adoc
WorkingDirectory=/opt/a-doc
EnvironmentFile=/etc/adoc/env
# Pull new PDFs in from the Dropbox app folder (via the "dropbox" rclone
# remote configured from the /a-doc/rclone-conf SSM parameter — see
# README.md), then run the ingestion pipeline over them. --min-age 1m avoids
# racing a file that Dropbox is still writing.
ExecStart=/usr/bin/rclone move dropbox:a-doc-inbox /data/a-doc-data/inbox \
    --include "*.pdf" --min-age 1m \
    --config /home/adoc/.config/rclone/rclone.conf
ExecStart=/opt/a-doc/.venv/bin/adoc ingest
