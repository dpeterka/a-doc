# Copy to .env and fill in. Never commit the real .env file.

# Provider API keys (bare names — see src/adoc/config.py AliasChoices)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# optional — only needed if the Featherless blind-panel role is enabled
FEATHERLESS_API_KEY=

# adoc-prefixed settings
ADOC_DATA_DIR=/data/a-doc-data
# Legacy single-passphrase web login - unused now that login is per-user
# (see `adoc user add`); kept only for backward compatibility.
ADOC_SESSION_PASSPHRASE=
# true only when this process is unreachable except through the ALB (set
# by the ECS task definitions in deploy/cfn/ecs.yaml in the deployed
# environment) - trusts the last hop of X-Forwarded-For/X-Forwarded-Proto
# for login rate limiting and secure cookies. Leave false/unset for local
# `adoc serve`.
ADOC_TRUST_FORWARDED_FOR=false
# sqlite journal mode for labs.sqlite - "WAL" (default) is fine locally;
# the deployed environment sets this to "TRUNCATE" because the data
# directory is an EFS mount and WAL is unsafe on NFS-family filesystems
# (see src/adoc/labs/db.py's LabsDb.__init__ docstring, ADR 0006).
ADOC_SQLITE_JOURNAL_MODE=WAL
# S3 bucket `adoc backup` uploads to (set by deploy/cfn/ecs.yaml in the
# deployed environment; leave unset for local dev - `adoc backup` fails
# fast with a clear error rather than silently no-op'ing).
ADOC_BACKUP_BUCKET=
